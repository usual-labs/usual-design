{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Usual Design onboarding proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "$ref": "manifest#/properties/include"
        },
        "ignore": {
          "$ref": "manifest#/properties/ignore"
        },
        "tokens": {
          "$ref": "manifest#/properties/tokens"
        }
      },
      "required": ["include"]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 0,
      "maxItems": 100
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "category": {
            "enum": ["colors", "typography", "spacing", "shape", "components"]
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "recommended": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": ["file", "line"]
                  },
                  "minItems": 1,
                  "maxItems": 100
                },
                "rules": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "allowed": {
                      "$ref": "manifest#/properties/allowed"
                    },
                    "semantics": {
                      "$ref": "manifest#/properties/semantics"
                    },
                    "components": {
                      "$ref": "manifest#/properties/components"
                    },
                    "imports": {
                      "$ref": "manifest#/properties/imports"
                    }
                  },
                  "required": []
                },
                "preview": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "light": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "primary": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "onPrimary": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "surface": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "onSurface": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "muted": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "border": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "focus": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "bodySize": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "headingSize": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "lineHeight": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "fontFamily": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "gap": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "padding": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "controlRadius": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "cardRadius": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        }
                      },
                      "required": []
                    },
                    "dark": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "primary": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "onPrimary": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "surface": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "onSurface": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "muted": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "border": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "focus": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "bodySize": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "headingSize": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "lineHeight": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "fontFamily": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "gap": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "padding": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "controlRadius": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "cardRadius": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        }
                      },
                      "required": []
                    }
                  },
                  "required": []
                }
              },
              "required": ["id", "label", "explanation", "evidence", "rules"]
            },
            "minItems": 1,
            "maxItems": 12
          }
        },
        "required": ["id", "category", "role", "title", "description", "recommended", "options"]
      },
      "minItems": 1,
      "maxItems": 60
    }
  },
  "required": ["version", "title", "summary", "scope", "decisions"]
}
