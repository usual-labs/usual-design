        "bg-accent",
        "bg-accent-dark",
        "bg-code",
        "bg-ink",
        "bg-muted",
        "bg-paper",
        "bg-soft",
        "bg-surface",
        "border-ink",
        "border-line",
        "text-accent",
        "text-code-ink",
        "text-ink",
        "text-muted",
        "text-surface"
