{
  "version": 1,
  "include": [
    "src/**/*.{js,jsx,ts,tsx}",
    "src/**/*.css"
  ],
  "ignore": [],
  "tokens": [
    "src/style.css"
  ],
  "active": [],
  "allowed": {
