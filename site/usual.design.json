      "variables": [
        "--radius-panel"
      ],
      "values": [
        "3px solid var(--color-accent)",
        "4px"
      ]
    }
  },
  "semantics": [
    {
      "id": "primary-action",
      "target": {
        "element": "a",
        "props": {
          "data-intent": "primary"
        }
      },
      "requireClasses": [
        "bg-accent",
        "text-surface"
      ]
    }
  ],
  "components": [
    {
      "id": "shared-button",
      "element": "button",
      "replacement": {
        "name": "Button",
        "from": "./components/Button"
      },
      "ignore": [
        "src/components/Button.tsx"
      ]
    }
  ]
