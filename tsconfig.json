{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "declaration": true,
    "sourceMap": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
