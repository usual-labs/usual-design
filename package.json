{
  "name": "@usualui/lint",
  "version": "0.1.0",
  "description": "Project-owned design contracts and deterministic feedback for AI-native development.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "usual-design": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.js.map",
    "dist/wizard",
    "schema",
    "skills",
    "docs/usage.md",
    "docs/compatibility.md",
    "docs/integrations.md",
    "docs/development.md",
    "docs/maintaining.md",
    "docs/publishing.md",
    "README.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE",
    "docs/demo.md",
    "site/README.md",
    "examples/ci.yml",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc && vite build --config wizard/vite.config.ts && vite build --config site/vite.config.ts",
    "build:core": "tsc",
    "typecheck": "tsc --noEmit && tsc -p wizard/tsconfig.json && tsc -p site/tsconfig.json",
    "test": "npm run test:core && npm run test:wizard",
    "dev:wizard": "vite --config wizard/vite.config.ts",
    "dev:site": "vite --config site/vite.config.ts",
    "test:core": "tsx --test test/*.test.ts",
    "test:wizard": "tsx --tsconfig wizard/tsconfig.json --test wizard/test/*.test.ts",
    "verify:package": "npm run build && node scripts/package-smoke.mjs",
    "benchmark": "npm run build:core && node scripts/benchmark.mjs",
    "audit:site": "node dist/cli.js audit --root site --save",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' 'wizard/src/**/*.{ts,tsx,css}' 'wizard/test/**/*.ts' 'site/src/**/*.{ts,tsx,css}' 'scripts/*.mjs' 'schema/*.json'"
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/types": "^7.28.0",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.0.3",
    "postcss": "^8.5.6",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "packageManager": "npm@10.9.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usual-labs/usual-design.git"
  },
  "bugs": {
    "url": "https://github.com/usual-labs/usual-design/issues"
  },
  "homepage": "https://github.com/usual-labs/usual-design#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
